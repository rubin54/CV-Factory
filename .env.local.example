# Kopieren nach .env.local und Key eintragen (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# Wie die Claude-Aufrufe laufen:
#   (nicht gesetzt)  normal gegen die API
#   fixture          Antworten kommen aus data/fixtures/ — kein Key nötig, keine
#                    Kosten, keine Wartezeit. Zum Arbeiten an Vorlagen und Bedienung.
#   record           normal gegen die API, die Antwort wird zusätzlich als Fixture
#                    abgelegt und ersetzt die vorhandene.
# CV_FACTORY_CLAUDE=fixture

# Preise pro Million Tokens für die Kostenschätzung. Nur anfassen, wenn sich die
# Preisliste geändert hat; die Vorgabe steht in lib/claude.ts.
# CV_FACTORY_PRICE_IN=15
# CV_FACTORY_PRICE_OUT=75
